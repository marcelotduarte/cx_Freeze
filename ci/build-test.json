{
  "matplotlib": {
    "test_app": "gui:matplotlib_eg",
    "find_links": ["https://wxpython.org/Phoenix/snapshot-builds/"],
    "requirements": [
      "numpy",
      "pillow --no-deps",
      "matplotlib",
      "wxPython==4.2.5"
    ]
  },
  "matplotlib_tk": {
    "test_app": "gui:test_matplotlib_tk",
    "requirements": ["numpy", "pillow --no-deps", "matplotlib"]
  },
  "opencv": {
    "test_app": "gui:test_opencv",
    "requirements": [
      "opencv-python --mingw=python-opencv --conda=py-opencv",
      "opencv-contrib-python --platform=macos --conda=opencv",
      "vtk"
    ]
  },
  "pyqt5": {
    "test_app": "gui:test_pyqt5",
    "requirements": "PyQt5 --conda=pyqt"
  },
  "pyqt5-simplebrowser": {
    "test_app": ["gui:test_simplebrowser"],
    "requirements": [
      "PyQt5 --conda=pyqt",
      "PyQtWebEngine --conda=pyqtwebengine"
    ],
    "platform": ["!mingw"]
  },
  "pyqt6": {
    "test_app": "gui:test_pyqt6",
    "requirements": ["PyQt6", "PyQt6-Qt6 --mingw="],
    "platform": ["!conda"],
    "comment": "conda doesn't support pyqt6"
  },
  "pyqt6-qml": {
    "test_app": "gui:test_qml",
    "requirements": ["PyQt6", "PyQt6-Qt6 --mingw="],
    "platform": ["!conda"]
  },
  "pyqt6-simplebrowser": {
    "test_app": "gui:test_simplebrowser",
    "requirements": [
      "PyQt6",
      "PyQt6-Qt6 --mingw=",
      "PyQt6-WebEngine --mingw=",
      "PyQt6-WebEngine-Qt6 --mingw="
    ],
    "platform": ["!mingw", "!conda"]
  },
  "pyside2": {
    "test_app": "gui:test_pyside2",
    "requirements": "PySide2",
    "platform": ["conda", "mingw"],
    "python-versions": ["3.11", "3.12"],
    "comment": "pyside2 does not support macos arm64"
  },
  "pyside6": {
    "test_app": "gui:test_pyside6",
    "requirements": "PySide6"
  },
  "pyside6-qml": {
    "test_app": "gui:test_qml",
    "requirements": "PySide6"
  },
  "pyside6-simplebrowser": {
    "test_app": "gui:test_simplebrowser",
    "requirements": "PySide6",
    "platform": ["!mingw", "!conda"]
  },
  "pythonnet-demo": {
    "test_app": ["gui:helloform", "gui:splitter", "gui:wordpad"],
    "requirements": "pythonnet>=3.0.0",
    "platform": ["windows"]
  },
  "service": {
    "test_app": [
      "cx_FreezeSampleService --install sample",
      "cx_FreezeSampleService --uninstall sample"
    ],
    "extra_index_url": ["https://test.pypi.org/simple/"],
    "requirements": "cx-logging",
    "platform": ["windows", "mingw"]
  },
  "service-asyncio": {
    "test_app": [
      "cx_FreezeSampleServiceAsyncio --install sample",
      "cx_FreezeSampleServiceAsyncio --uninstall sample"
    ],
    "extra_index_url": ["https://test.pypi.org/simple/"],
    "requirements": "cx-logging",
    "platform": ["windows", "mingw"]
  },
  "tkinter": {
    "test_app": "gui:test_tkinter",
    "requirements": "--mingw=tk --conda=tk"
  }
}
